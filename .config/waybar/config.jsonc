 // -*- mode: jsonc -*-
 // 「」
{
    "spacing": 8,

    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "sway/window"
    ],

    "modules-right": [
        "battery",
        "pulseaudio",
        "clock",
        "tray"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "warp-on-scroll": false,
        "persistent-workspaces": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
            "9": "九",
            "10": "十"
        },
        "format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
            "9": "九",
            "10": "十"
        }
    },

    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },

    "sway/window": {
        "format": "「{title}」"
    },

    "tray": {
        "spacing": 4
    },

    "clock": {
        "format": "{:%Y-%m-%d %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    },

    "pulseaudio": {
        "format": "VOL: {volume}%",
        "on-click": "pavucontrol"
    },

    "battery": {
        "bat": "BAT0",
        "interval": 60,
        "format": "BAT: {capacity}%"
    }
}
