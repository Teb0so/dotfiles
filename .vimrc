"Set leader
let mapleader = " "

"set syntax
syntax on

" Load theme
colorscheme wildcharm
set background=light

"Set binds
nnoremap <leader>, :Ex<CR>

"Set identation
set expandtab
set tabstop=4
set softtabstop=4
set shiftwidth=4

"set numbers
set number
set relativenumber

"set dots
set list
set listchars=tab:-->,space:·

